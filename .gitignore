# Ignore bundler config.
/.bundle

# Vendored gems (local bundle install path)
/vendor/bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore uploaded files in development.
/storage/*
!/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore SQLite3 databases.
/db/*.sqlite3
/db/*.sqlite3-journal

# Ignore Byebug history
.byebug_history

# Ignore environment overrides
.env
.env.local
.env.*.local

# Ignore Fly.io token
.fly-token

# Ignore secrets folder
secrets/

# Ignore coverage
/coverage

# Ignore system artifacts
.DS_Store
Thumbs.db

# Ignore demo video frames (generated via npm run capture)
demo/video/frame-*.png

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~
Opencode/
ZCODE/

# Ignore OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Fly.io CLI binary (should never be committed)
flyctl.zip
flyctl.exe

# Redis infra config contains a generated password
infra/redis/fly.toml

# Shopify CLI bundle (regenerated via shopify app deploy)
.shopify/

# Node.js demo tooling (puppeteer for video capture)
node_modules/
npm-debug.log*

# Demo pipeline intermediate files (regenerable)
demo/autoplay/temp_segments/
demo/autoplay/test_output.mp4
demo/autoplay/frames/01_health.png
demo/autoplay/frames/03_storefront_filters.png
demo/autoplay/frames/04_github_repo.png
demo/autoplay/frames/05_github_readme.png
/demo/autoplay/video_v3/
/demo/autoplay/video_live/
demo/autoplay/live_schedule.json
demo/video/audio_tmp/

# Agent/tooling working directories (not project source)
.freebuff/
.playwright-mcp/
.claude/
.mcp.json

# Client-facing report deliverables (generated via scripts/make_reports.py —
# sent to the client separately, not part of the codebase)
/out/
.archify/
