 "cards": [
  {
   "dot": "cyan",
   "title": "Storefront path",
   "items": [
    "Theme JS calls the App Proxy; Shopify signs every query",
    "Controllers reject bad HMAC before any lookup",
    "Search results cached per shop version"
   ]
  },
  {
   "dot": "emerald",
   "title": "Merchant + sync",
   "items": [
    "Admin writes fitments, then enqueues Sidekiq jobs",
    "Jobs push custom.vehicle_fitment via metafieldsSet",
    "Throttling and retries live in the GraphQL client"
   ]
  },
  {
   "dot": "rose",
   "title": "Security",
   "items": [
    "App Proxy and webhooks both verify HMAC-SHA256",
    "WebhookDelivery blocks replayed webhook ids",
    "Shop tokens encrypted at rest"
   ]
  }
 ]
